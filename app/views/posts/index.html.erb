
<body class="bg-gray-100 pb-6">
<div class="max-w-2xl mx-auto">
  <!-- Post Card -->
  <div class="bg-white rounded-lg shadow-sm overflow-hidden">
    <div class="px-4 py-4 border-b-gray-200">
      <%= form_with model: @post, local: true do |form| %>
        <div>
          <%= form.text_area :content, placeholder: "What's on your mind?", class:"block p-5.5 w-full text-xl text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500"%>
        </div>
        <div class="flex mt-4">
          <%= form.submit "Post Status", class: "px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 hover:cursor-pointer" %>
        </div>
      <% end %>
    </div>
    <!-- Post Header -->
    <% @posts.each do |post| %>
      <div class="p-4 border-b border-gray-200">
        <div class="flex items-center space-x-3">
          <img src="https://randomuser.me/api/portraits/women/44.jpg" alt="User avatar" class="w-10 h-10 rounded-full object-cover">
          <div>
            <h3 class="font-semibold text-gray-900"><%= post.user.name %></h3>
            <p class="text-xs text-gray-500">2 hours ago</p>
          </div>
        </div>
      </div>

      <div class="p-4 space-y-2">
        <p class="text-gray-800 leading-relaxed">
          <%= post.content %>
        </p>
      </div>

      <!-- Post Actions -->
      <div class="px-4 py-2 border-t border-gray-200">
        <div class="flex justify-around">
          <button class="flex items-center space-x-1 px-3 py-1.5 rounded-md hover:bg-blue-50 hover:text-blue-600 text-gray-600 hover:cursor-pointer">
            <i class="far fa-thumbs-up"></i>
            <span>Like</span>
          </button>
          <button class="flex items-center space-x-1 px-3 py-1.5 rounded-md hover:bg-blue-50 hover:text-blue-600 text-gray-600 hover:cursor-pointer">
            <i class="far fa-comment"></i>
            <span>Comment</span>
          </button>
        </div>
      </div>


    <% end %>




    <!-- Comments Section -->
    <div class="bg-gray-50 p-4">
      <h4 class="font-bold text-gray-800 mb-3 ">Comments</h4>

      <!-- Comment 1 -->
      <div class="bg-white rounded-lg shadow-xs p-3 mb-3">
        <div class="flex items-center space-x-2 mb-2">
          <img src="https://randomuser.me/api/portraits/men/32.jpg" alt="Commenter avatar" class="w-8 h-8 rounded-full object-cover">
          <div>
            <h5 class="font-semibold text-sm text-gray-900">Michael Chen</h5>
            <p class="text-xs text-gray-500">1 hour ago</p>
          </div>
        </div>
        <p class="text-sm text-gray-700 mb-2">That looks amazing! Which trail did you take?</p>
        <div class="flex space-x-3 text-xs text-gray-500">
          <button class="hover:underline hover:cursor-pointer">Like (3)</button>
          <button class="hover:underline reply-button hover:cursor-pointer">Reply</button>
        </div>

        <!-- Reply Input (Hidden by default) -->
        <div class="mt-3 pl-6 border-l-2 border-gray-200 hidden reply-input">
          <div class="mt-2">
            <textarea placeholder="Write a reply..." class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"></textarea>
            <div class="flex justify-end space-x-2 mt-2">
              <button class="px-3 py-1.5 text-sm text-gray-600 rounded-md hover:bg-gray-100 cancel-reply">Cancel</button>
              <button class="px-3 py-1.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">Post Reply</button>
            </div>
          </div>
        </div>

        <!-- Reply to Comment 1 -->
        <div class="mt-3 pl-6 border-l-2 border-gray-200">
          <div class="bg-gray-100 rounded-lg shadow-xs p-3">
            <div class="flex items-center space-x-2 mb-2">
              <img src="https://randomuser.me/api/portraits/women/44.jpg" alt="Replier avatar" class="w-7 h-7 rounded-full object-cover">
              <div>
                <h5 class="font-semibold text-sm text-gray-900">Sarah Johnson</h5>
                <p class="text-xs text-gray-500">45 minutes ago</p>
              </div>
            </div>
            <p class="text-sm text-gray-700 mb-2">It was the Pine Ridge Trail. The first half is a bit steep but the view is worth it!</p>
            <div class="flex space-x-3 text-xs text-gray-500">
              <button class="hover:underline hover:cursor-pointer">Like (1)</button>
              <button class="hover:underline reply-button hover:cursor-pointer">Reply</button>
            </div>

            <!-- Nested Reply Input (Hidden by default) -->
            <div class="mt-3 pl-6 border-l-2 border-gray-200 hidden reply-input">
              <div class="mt-2">
                <textarea placeholder="Write a reply..." class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"></textarea>
                <div class="flex justify-end space-x-2 mt-2">
                  <button class="px-3 py-1.5 text-sm text-gray-600 rounded-md hover:bg-gray-100 cancel-reply">Cancel</button>
                  <button class="px-3 py-1.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">Post Reply</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Comment 2 -->
      <div class="bg-white rounded-lg shadow-xs p-3">
        <div class="flex items-center space-x-2 mb-2">
          <img src="https://randomuser.me/api/portraits/women/68.jpg" alt="Commenter avatar" class="w-8 h-8 rounded-full object-cover">
          <div>
            <h5 class="font-semibold text-sm text-gray-900">Emma Rodriguez</h5>
            <p class="text-xs text-gray-500">30 minutes ago</p>
          </div>
        </div>
        <p class="text-sm text-gray-700 mb-2">Beautiful photo! We should organize a group hike soon.</p>
        <div class="flex space-x-3 text-xs text-gray-500">
          <button class="hover:underline hover:cursor-pointer">Like (2)</button>
          <button class="hover:underline reply-button hover:cursor-pointer">Reply</button>
        </div>

        <!-- Reply Input (Hidden by default) -->
        <div class="mt-3 pl-6 border-l-2 border-gray-200 hidden reply-input">
          <div class="mt-2">
            <textarea placeholder="Write a reply..." class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"></textarea>
            <div class="flex justify-end space-x-2 mt-2">
              <button class="px-3 py-1.5 text-sm text-gray-600 rounded-md hover:bg-gray-100 cancel-reply">Cancel</button>
              <button class="px-3 py-1.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">Post Reply</button>
            </div>
          </div>
        </div>
      </div>

      <!-- New Comment Input -->
      <div class="mt-4">
        <textarea placeholder="Write a comment..." class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"></textarea>
        <div class="flex justify-end mt-2">
          <button class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
            Post Comment
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
    // Simple JavaScript to toggle reply inputs
    document.querySelectorAll('.reply-button').forEach(button => {
        button.addEventListener('click', () => {
            const replyInput = button.closest('div').nextElementSibling;
            replyInput.classList.toggle('hidden');
        });
    });

    document.querySelectorAll('.cancel-reply').forEach(button => {
        button.addEventListener('click', () => {
            const replyInput = button.closest('.reply-input');
            replyInput.classList.add('hidden');
        });
    });
</script>
</body>
