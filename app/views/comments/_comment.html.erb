<div class="mt-3 pl-6 border-l-2 border-gray-200">
  <div class="bg-gray-100 rounded-lg shadow-xs p-3">
    <div class="flex items-center space-x-2 mb-2">
      <img src="https://randomuser.me/api/portraits/women/44.jpg" alt="User avatar" class="w-7 h-7 rounded-full object-cover">
      <div>
        <h5 class="font-semibold text-sm text-gray-900"><%= comment.user.name %></h5>
        <p class="text-xs text-gray-500"><%= time_ago_in_words(comment.created_at) %> ago</p>
      </div>
    </div>

    <p class="text-sm text-gray-700 mb-2"><%= comment.content %></p>

    <div class="flex space-x-3 text-xs text-gray-500">
      <button class="hover:underline hover:cursor-pointer">Like (<%= comment.likes.count %>)</button>
      <button data-action="click->reply#toggle" class="hover:underline reply-button hover:cursor-pointer">Reply</button>
    </div>

    <!-- Reply Form -->
    <div class="mt-3 hidden reply-input">
      <%= form_with(model: [comment.post, Comment.new], local: true) do |f| %>
        <%= f.hidden_field :parent_id, value: comment.id %>
        <div>
          <%= f.text_area :content, placeholder: "Write a reply...", class:"w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>
        <div class="flex justify-end space-x-2 mt-2">
          <button data-action="click->reply#cancel" class="px-3 py-1.5 text-sm text-gray-600 rounded-md hover:bg-gray-100 cancel-reply hover:cursor-pointer">Cancel</button>
          <%= f.submit "Reply", class:"px-3 py-1.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700" %>
        </div>
      <% end %>
    </div>

    <!-- 🔁 Recursive render of child comments -->
    <% comment.children.each do |child| %>
      <%= render partial: "comments/comment", locals: { comment: child } %>
    <% end %>

  </div>
</div>
